#!/system/bin/sh

# AshReXcue Command Executor
# Auto-escalates to Root for module operations

# --- Setup ---
MOD_DIR="/data/adb/modules/AshLooper"
BB_CANDIDATES="/data/adb/ksu/bin/busybox /data/adb/magisk/busybox /data/adb/ap/bin/busybox /system/bin/busybox"
BB="busybox"
for candidate in $BB_CANDIDATES; do
    [ -x "$candidate" ] && BB="$candidate" && break
done

# Auth Check
TOKEN_FILE="../nexus/uplink_key"
[ ! -f "$TOKEN_FILE" ] && exit 1
REAL_TOKEN=$(cat "$TOKEN_FILE" 2>/dev/null)
INCOMING_TOKEN=$(echo "$HTTP_X_ASH_TOKEN" | tr -d '[:space:]')
[ "$INCOMING_TOKEN" != "$REAL_TOKEN" ] && exit 1

# Heartbeat
[ -f "../../.session_state" ] && echo "$(cat ../nexus/server_port) $(($(date +%s) + 300)) $(date +%s)" > "../../.session_state"

# --- Safety & Helper Functions ---
SAFE_DIRS="/cache/looper/ $MOD_DIR/ /data/local/tmp/ /storage/emulated/0/Download/"

is_safe_path() {
    case "$1" in *..*) return 1 ;; esac
    for safe_dir in $SAFE_DIRS; do
        case "$1" in "$safe_dir"*) return 0 ;; esac
    done
    return 1
}

run_smart() {
    # Force root if touching Module Directory (system partition)
    if echo "$1" | grep -q "$MOD_DIR"; then
        su -c "$BB sh -c '$1'" 2>&1
    else
        $BB sh -c "$1" 2>&1
    fi
}

# --- Execution Logic ---
RAW_CMD=$(cat)
VERB=$(echo "$RAW_CMD" | awk '{print $1}')

case "$VERB" in
    ls|cat|rm)
        CLEAN_CMD=$(echo "$RAW_CMD" | sed -E 's/^(ls -1|ls|cat|rm) //')
        FILE=$(echo "$CLEAN_CMD" | tr -d '"' | tr -d "'")
        
        if is_safe_path "$FILE"; then
            OUTPUT=$(run_smart "$RAW_CMD")
        else
            OUTPUT="Access Denied: Restricted Path"
        fi
        ;;

    cp|mv)
        SRC=$(echo "$RAW_CMD" | awk '{print $2}' | tr -d '"' | tr -d "'")
        DST=$(echo "$RAW_CMD" | awk '{print $3}' | tr -d '"' | tr -d "'")
        
        if is_safe_path "$SRC" && is_safe_path "$DST"; then
            # Force Root if source or dest is in Module Dir
            if echo "$SRC" | grep -q "$MOD_DIR" || echo "$DST" | grep -q "$MOD_DIR"; then
                su -c "$BB cp -f \"$SRC\" \"$DST\"" 2>&1
                [ "$VERB" = "mv" ] && su -c "rm \"$SRC\""
            else
                $BB cp "$SRC" "$DST" 2>&1
                [ "$VERB" = "mv" ] && rm "$SRC"
            fi
            OUTPUT="Operation Success"
        else
            OUTPUT="Access Denied: Restricted Path"
        fi
        ;;

    sed|echo)
        TARGET="$MOD_DIR/settings.prop"
        
        # Only allow touching settings.prop
        if echo "$RAW_CMD" | grep -q "settings.prop"; then
            if [ "$VERB" = "echo" ]; then
                # Clean extract: echo "key=val" >> file
                CONTENT=$(echo "$RAW_CMD" | sed -E 's/^echo "//; s/" >>.*//')
                su -c "echo \"$CONTENT\" >> \"$TARGET\"" 2>&1
                OUTPUT="Settings Appended"
            else
                # Clean extract: sed -i "regex" file
                EXPR=$(echo "$RAW_CMD" | awk -F'"' '{print $2}')
                [ -n "$EXPR" ] && su -c "$BB sed -i \"$EXPR\" \"$TARGET\"" 2>&1
                OUTPUT="Settings Updated"
            fi
        elif [ "$VERB" = "sed" ]; then
            # Allow log extraction (usually /cache)
            OUTPUT=$(run_smart "$RAW_CMD")
        else
            OUTPUT="Access Denied"
        fi
        ;;

    pgrep|pkill)
        # Only allow killing own httpd process
        if echo "$RAW_CMD" | grep -q "httpd -p 127.0.0.1:"; then
            $BB $RAW_CMD 2>&1
            [ "$VERB" = "pkill" ] && OUTPUT="Service Stopped"
        else
             OUTPUT="Access Denied"
        fi
        ;;

    date|uptime|printf)
        OUTPUT=$(run_smart "$RAW_CMD")
        ;;

    *) OUTPUT="Unknown Command" ;;
esac

# --- Output ---
echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

JQ="$MOD_DIR/jq/jq"
if [ -x "$JQ" ]; then
    printf '%s' "$OUTPUT" | "$JQ" -Rs --argjson code "0" '{code: $code, stdout: .}'
else
    SAFE_OUT=$(printf '%s' "$OUTPUT" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a;N;$!ba;s/\n/\\n/g')
    printf '{"code": 0, "stdout": "%s"}\n' "$SAFE_OUT"
fi